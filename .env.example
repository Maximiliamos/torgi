APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

POSTGRES_DB=bankrotai
POSTGRES_USER=bankrotai
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=postgresql+psycopg://bankrotai:replace-with-a-long-random-password@postgres:5432/bankrotai
REDIS_URL=redis://:replace-with-a-different-long-random-password@redis:6379/0
DEFAULT_REGION_SLUG=yaroslavl
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.example
API_RATE_LIMIT_PER_MINUTE=120
ALLOW_LOCAL_TASK_FALLBACK=false
SYNC_RETRY_MAX_ATTEMPTS=4
SYNC_RETRY_BACKOFF_SECONDS=5
CELERY_SOFT_TIME_LIMIT=1500
CELERY_HARD_TIME_LIMIT=1800
EXTERNAL_CONNECT_TIMEOUT=5
EXTERNAL_READ_TIMEOUT=30
NSPD_CA_BUNDLE=
NSPD_ALLOW_INSECURE_DEBUG=false
BANKROTAI_API_KEY=replace-with-at-least-24-random-characters
WEB_BASIC_AUTH_USER=bankrotai
WEB_BASIC_AUTH_PASSWORD=replace-with-a-third-long-random-password
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL_SEARCH=gpt-4o-mini-search-preview
OPENAI_MODEL_RISK=gpt-4o-mini
OPENAI_BASE_URL=

AI_PROVIDER=omniroute
AI_ALLOW_PROVIDER_FALLBACK=false
OMNIROUTE_API_KEY=sk_omniroute
OMNIROUTE_API_BASE=http://localhost:20128
OMNIROUTE_MODEL=kr/claude-sonnet-4
OMNIROUTE_PROTOCOL=openai

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROK_API_KEY=
GROK_MODEL=grok-2
GITHUB_MODELS_API_KEY=
GITHUB_MODEL=openai/gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<YOUR_CHAT_OR_CHANNEL_ID>

T_BANKROT_BASE_URL=https://api.tbankrot.ru
T_BANKROT_LOTS_PATH=/api/lots
T_BANKROT_API_KEY=<YOUR_TBANKROT_API_KEY>
T_BANKROT_RECENT_HOURS=24
T_BANKROT_PAGE_SIZE=50
T_BANKROT_SALE_TYPES=direct_sale,public_offer
