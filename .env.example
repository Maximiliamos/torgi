APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

POSTGRES_DB=bankrotai
POSTGRES_USER=bankrotai
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=postgresql+psycopg://bankrotai:replace-with-a-long-random-password@postgres:5432/bankrotai
# Neon runtime URL must use the -pooler hostname and mandatory TLS/channel binding.
# DATABASE_URL=postgresql+psycopg://user:password@ep-name-pooler.region.neon.tech/db?sslmode=require&channel_binding=require
# Alembic, pg_dump and initial import must use the direct hostname without -pooler.
DATABASE_MIGRATION_URL=
REDIS_URL=redis://:replace-with-a-different-long-random-password@redis:6379/0
DEFAULT_REGION_SLUG=yaroslavl
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.example
API_RATE_LIMIT_PER_MINUTE=60
ALLOW_LOCAL_TASK_FALLBACK=false
SYNC_RETRY_MAX_ATTEMPTS=4
SYNC_RETRY_BACKOFF_SECONDS=5
CELERY_SOFT_TIME_LIMIT=1500
CELERY_HARD_TIME_LIMIT=1800
CELERY_NATIONWIDE_SOFT_TIME_LIMIT=3300
CELERY_NATIONWIDE_HARD_TIME_LIMIT=3600
EXTERNAL_CONNECT_TIMEOUT=5
EXTERNAL_READ_TIMEOUT=30
NSPD_CA_BUNDLE=
NSPD_ALLOW_INSECURE_DEBUG=false
BANKROTAI_API_KEY=replace-with-at-least-24-random-characters
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=28800
API_READ_ONLY=false
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=10
WEB_BASIC_AUTH_USER=bankrotai
WEB_BASIC_AUTH_PASSWORD=replace-with-a-third-long-random-password
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL_SEARCH=gpt-4o-mini-search-preview
OPENAI_MODEL_RISK=gpt-4o-mini
OPENAI_BASE_URL=

AI_PROVIDER=omniroute
AI_ALLOW_PROVIDER_FALLBACK=false
OMNIROUTE_API_KEY=sk_omniroute
OMNIROUTE_API_BASE=http://localhost:20128
OMNIROUTE_MODEL=kr/claude-sonnet-4
OMNIROUTE_PROTOCOL=openai

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROK_API_KEY=
GROK_MODEL=grok-2
GITHUB_MODELS_API_KEY=
GITHUB_MODEL=openai/gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<YOUR_CHAT_OR_CHANNEL_ID>

T_BANKROT_BASE_URL=https://api.tbankrot.ru
T_BANKROT_LOTS_PATH=/api/lots
T_BANKROT_API_KEY=<YOUR_TBANKROT_API_KEY>
T_BANKROT_RECENT_HOURS=24
T_BANKROT_PAGE_SIZE=50
T_BANKROT_SALE_TYPES=direct_sale,public_offer

# Parallel network workers for bulk GEO. Nominatim requests remain globally
# rate-limited; parallelism mainly accelerates cadastral and cached lookups.
GEO_BATCH_LIMIT=500
GEO_MAX_WORKERS=6
GEO_NSPD_CONCURRENCY=2
GEO_BULK_IK12_FALLBACK=false
GEO_BULK_NOMINATIM_FALLBACK=false

# REG.RU S3 map publication. Keep disabled until the public bucket and CORS are configured.
MAP_OBJECT_STORE_ENABLED=false
MAP_OBJECT_STORE_ENDPOINT=https://s3.regru.cloud
MAP_OBJECT_STORE_BUCKET=sterdez-map
MAP_OBJECT_STORE_PUBLIC_BASE_URL=
MAP_OBJECT_STORE_ACCESS_KEY=
MAP_OBJECT_STORE_SECRET_KEY=
MAP_OBJECT_STORE_REGION=ru-1
# tiles = legacy one-object-per-tile transport
# regional-bundles-v1 = content-addressed regional/spatial bundles (recommended after rollout validation)
MAP_OBJECT_STORE_LAYOUT=tiles
MAP_OBJECT_STORE_WORKERS=4
MAP_OBJECT_STORE_TIMEOUT_SECONDS=60
PHOTON_BASE_URL=

# Official EFRSB Publications API. Credentials are issued by the operator.
FEDRESURS_BASE_URL=https://bank-publications-prod.fedresurs.ru
FEDRESURS_LOGIN=
FEDRESURS_PASSWORD=
