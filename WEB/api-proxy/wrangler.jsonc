{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "bankrotai-api-proxy",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.dezster.ru/*",
      "zone_name": "dezster.ru"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "containers": [
    {
      "class_name": "BankrotAISecondary",
      "image": "../../Dockerfile",
      "max_instances": 1,
      "instance_type": "lite",
      "constraints": { "regions": ["EEUR", "WEUR"] }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BANKROTAI_SECONDARY", "class_name": "BankrotAISecondary" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BankrotAISecondary"] }
  ]
}
