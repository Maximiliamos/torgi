{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "bankrotai-api-proxy",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "vars": {
    "PRIMARY_API_ORIGIN": "https://home-relay.194-226-126-233.sslip.io",
    "SECONDARY_API_ORIGIN": "https://194-226-126-233.sslip.io"
  },
  "routes": [
    {
      "pattern": "api.sterdez.online/*",
      "zone_name": "sterdez.online"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
