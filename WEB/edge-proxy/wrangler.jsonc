{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "bankrotai-domain-proxy",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-14",
  "workers_dev": false,
  "services": [
    {
      "binding": "API_PROXY",
      "service": "bankrotai-api-proxy"
    }
  ],
  "routes": [
    {
      "pattern": "sterdez.online/*",
      "zone_name": "sterdez.online"
    },
    {
      "pattern": "www.sterdez.online/*",
      "zone_name": "sterdez.online"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
