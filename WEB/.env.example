APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

WEB_PORT=80
POSTGRES_DB=bankrotai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

DEFAULT_REGION_SLUG=yaroslavl
CORS_ORIGINS=https://your-domain.example,http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=120
BANKROTAI_API_KEY=change-me-for-protected-actions

AI_PROVIDER=omniroute
OMNIROUTE_API_KEY=sk_omniroute
OMNIROUTE_API_BASE=http://host.docker.internal:20128
OMNIROUTE_MODEL=kr/claude-sonnet-4
OMNIROUTE_PROTOCOL=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_SEARCH=gpt-4o
OPENAI_MODEL_RISK=gpt-4o-mini

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROK_API_KEY=
GROK_MODEL=grok-2
GITHUB_MODELS_API_KEY=
GITHUB_MODEL=openai/gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
